                              Fill="#A78BFA" Width="16" Height="16" Stretch="Uniform"/>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Clients Detected" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMute}"/>
                        <TextBlock Text="{Binding ClientsCountStr}" FontSize="22" FontWeight="Black" Foreground="{StaticResource TextPri}" Margin="0,3,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Border Width="34" Height="34" CornerRadius="9" Background="#123B3F" VerticalAlignment="Top">
                        <Path Data="M6,2A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2H6M13,3.5L18.5,9H13V3.5M8,12H16V14H8V12M8,16H13V18H8V16Z"
                              Fill="#5EEAD4" Width="16" Height="16" Stretch="Uniform"/>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Total RAM Usage" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMute}"/>
                        <TextBlock Text="{Binding TotalRamStr}" FontSize="22" FontWeight="Black" Foreground="{StaticResource TextPri}" Margin="0,3,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Border Grid.Column="4" Style="{StaticResource StatCard}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Border Width="34" Height="34" CornerRadius="9" Background="#123049" VerticalAlignment="Top">
                        <Path Data="M2,20H22V4H2V20M20,18H4V6H20V18M6,8H18V10H6V8M6,12H18V14H6V12M6,16H14V18H6V16Z"
                              Fill="#7DD3FC" Width="16" Height="16" Stretch="Uniform"/>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Disk Footprint" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMute}"/>
                        <TextBlock Text="{Binding DiskFootprintStr}" FontSize="22" FontWeight="Black" Foreground="{StaticResource TextPri}" Margin="0,3,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <Border Grid.Column="6" Style="{StaticResource StatCard}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Border Width="34" Height="34" CornerRadius="9" Background="#402A18" VerticalAlignment="Top">
                        <Path Data="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"
                              Fill="#FBBF6A" Width="16" Height="16" Stretch="Uniform"/>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Last Patched" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMute}"/>
                        <TextBlock Text="{Binding LastPatchedStr}" FontSize="16" FontWeight="Black" Foreground="{StaticResource TextPri}" Margin="0,6,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </Grid>

                <!-- List of Discord Clients -->
                <Grid Grid.Row="2">
                  <TextBlock x:Name="Txt_EmptyState" Text="No Discord installations found. Click Refresh List after installing Discord."
                             Foreground="{StaticResource TextMute}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                             Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"/>
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="LB_Clients" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource DashCardItem}" SelectionMode="Multiple">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,16,0"/>

                            <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10" Background="#1B1533" Margin="0,0,14,0">
                              <Path Data="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"
                                    Fill="#5865F2" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPri}"/>
                              <TextBlock Text="{Binding ResourcesDir}" FontSize="12" Foreground="{StaticResource TextMute}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="3" CornerRadius="20" Padding="12,5" Background="{Binding BadgeBg}" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{Binding BadgeFg}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="Bold" Foreground="{Binding BadgeFg}"/>
                              </StackPanel>
                            </Border>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </ScrollViewer>
                </Grid>

                <!-- Action Bar -->
                <Grid Grid.Row="3" Margin="0,22,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh List" Style="{StaticResource BtnGhost}" Height="34" Padding="14,0" FontSize="12" Click="Btn_RefreshDash_Click"/>
                    <CheckBox x:Name="CB_SelectAll" Content="Select all" Margin="18,0,0,0" Click="CB_SelectAll_Click"/>
                  </StackPanel>

                  <Button Grid.Column="1" x:Name="Btn_UninstallSelected" Content="Uninstall Selected" Style="{StaticResource BtnGhost}" Margin="0,0,12,0" Click="Btn_UninstallSelected_Click"/>
                  <Button Grid.Column="2" x:Name="Btn_PatchSelected" Content="Patch Selected" Style="{StaticResource BtnPrimary}" Click="Btn_PatchSelected_Click"/>
                </Grid>
              </Grid>

              <!-- ==== VIEW: PROCESS MANAGER ==== -->
              <Grid x:Name="V_Proc" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,22">
                  <TextBlock Text="Process Manager" FontSize="30" FontWeight="Black" Foreground="{StaticResource TextPri}" Margin="0,0,0,4"/>
                  <TextBlock Text="View and terminate running Discord processes to ensure clean installation." FontSize="14" Foreground="{StaticResource TextSec}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <ListBox x:Name="LB_Procs" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource DashCardItem}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>

                          <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#1B1533" Margin="0,0,14,0">
                            <Path Data="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"
                                  Fill="#5865F2" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>

                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPri}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                              <TextBlock Text="PID: " FontSize="12" Foreground="{StaticResource TextMute}"/>
                              <TextBlock Text="{Binding Pid}" FontSize="12" Foreground="{StaticResource TextSec}" Margin="0,0,12,0"/>
                              <TextBlock Text="RAM: " FontSize="12" Foreground="{StaticResource TextMute}"/>
                              <TextBlock Text="{Binding Ram}" FontSize="12" Foreground="{StaticResource TextSec}"/>
                            </StackPanel>
                          </StackPanel>

                          <Button Grid.Column="2" Content="Kill" Style="{StaticResource BtnGhost}" Height="34" Padding="18,0"
                                  Tag="{Binding Pid}" Click="Btn_KillProc_Click"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </ScrollViewer>

                <!-- Action Bar -->
                <Grid Grid.Row="2" Margin="0,22,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Column="0" x:Name="Txt_ProcCount" Text="0 Processes Running" VerticalAlignment="Center" Foreground="{StaticResource TextMute}"/>
                  <Button Grid.Column="1" x:Name="Btn_KillAll" Content="Force Kill All Discords" Style="{StaticResource BtnDanger}" Click="Btn_KillAll_Click"/>
                </Grid>
              </Grid>

              <!-- ==== VIEW: SETTINGS ==== -->
              <Grid x:Name="V_Set" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Text="Settings" FontSize="30" FontWeight="Black" Foreground="{StaticResource TextPri}" Margin="0,0,0,4"/>
                  <TextBlock Text="Configure installer behavior." FontSize="14" Foreground="{StaticResource TextSec}" Margin="0,0,0,28"/>

                  <!-- Setting Card -->
                  <Border Background="{StaticResource BgCard}" CornerRadius="14" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="20">
                    <StackPanel>
                      <TextBlock Text="Local App.asar Source" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPri}" Margin="0,0,0,6"/>
                      <TextBlock Text="Use a local app.asar file instead of downloading from patchcord.itssolar.dev." FontSize="13" Foreground="{StaticResource TextSec}" Margin="0,0,0,16"/>

                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TB_LocalAsar" Grid.Column="0" Height="40" Padding="12,0" VerticalContentAlignment="Center"
                                 Background="#18181F" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Foreground="{StaticResource TextPri}" Margin="0,0,12,0"/>
                        <Button Grid.Column="1" Content="Browse..." Style="{StaticResource BtnGhost}" Click="Btn_BrowseAsar_Click"/>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <!-- Setting Card -->
                  <Border Background="{StaticResource BgCard}" CornerRadius="14" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="20" Margin="0,16,0,0">
                    <StackPanel>
                      <TextBlock Text="Auto-Close" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPri}" Margin="0,0,0,6"/>
                      <CheckBox x:Name="CB_AutoClose" Content="Close installer automatically after successful patch" IsChecked="False" Margin="0,8,0,0"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>

              <!-- ==== VIEW: UPDATE ==== -->
              <Grid x:Name="V_Upd" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,22">
                  <TextBlock Text="Update" FontSize="30" FontWeight="Black" Foreground="{StaticResource TextPri}" Margin="0,0,0,4"/>
                  <TextBlock Text="Check for and install the latest version of Patchcord Installer." FontSize="14" Foreground="{StaticResource TextSec}"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                  <!-- Current / Latest version card -->
                  <Border Background="{StaticResource BgCard}" CornerRadius="14" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="20">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="Installed Version" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMute}"/>
                        <TextBlock x:Name="Upd_CurrentVer" Text="—" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPri}" Margin="0,4,0,0"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Latest Version" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMute}"/>
                        <TextBlock x:Name="Upd_LatestVer" Text="Checking…" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPri}" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <!-- Status / Notes card -->
                  <Border Background="{StaticResource BgCard}" CornerRadius="14" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="20" Margin="0,16,0,0">
                    <StackPanel>
                      <TextBlock x:Name="Upd_StatusText" Text="Checking for updates…" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPri}" Margin="0,0,0,6"/>
                      <TextBlock x:Name="Upd_NotesText" Text="" FontSize="13" Foreground="{StaticResource TextSec}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>

                  <!-- Force update warning -->
                  <Border x:Name="Upd_ForceBanner" Background="#2D0C14" CornerRadius="14" BorderBrush="#F43F5E" BorderThickness="1" Padding="16" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock Text="This version is no longer supported. You must update before continuing." FontSize="13" FontWeight="Bold" Foreground="#FCA5A5" TextWrapping="Wrap"/>
                  </Border>

                  <!-- Progress -->
                  <ProgressBar x:Name="Upd_Progress" Height="8" Margin="0,16,0,0" Visibility="Collapsed"
                               Background="#18181F" BorderThickness="0" Foreground="{StaticResource AccentA}"/>

                  <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" x:Name="Btn_CheckUpdate" Content="Check Again" Style="{StaticResource BtnGhost}" Margin="0,0,12,0" Click="Btn_CheckUpdate_Click"/>
                    <Button Grid.Column="2" x:Name="Btn_InstallUpdate" Content="Update Now" Style="{StaticResource BtnPrimary}" IsEnabled="False" Click="Btn_InstallUpdate_Click"/>
                  </Grid>
                </StackPanel>
              </Grid>

              <!-- ==== VIEW: ACTION (Overlay) ==== -->
              <Grid x:Name="V_Action" Visibility="Collapsed" Background="#D9000000">
                <Border Background="{StaticResource BgCard}" CornerRadius="18" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Width="520" Height="420" Padding="32">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="Act_Title" Text="Patching Clients..." FontSize="22" FontWeight="Black" Foreground="{StaticResource TextPri}" Margin="0,0,0,16" HorizontalAlignment="Center"/>

                    <ScrollViewer Grid.Row="1" x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Background="#09090C" Padding="14">
                      <ItemsControl x:Name="LogItems">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                              <Run Text="{Binding Prefix}" Foreground="{Binding Color}" FontWeight="Bold"/>
                              <Run Text=" "/>
                              <Run Text="{Binding Message}" Foreground="{StaticResource TextSec}"/>
                            </TextBlock>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2" x:Name="Btn_FinishAction" Content="Close" Style="{StaticResource BtnGhost}" Margin="0,16,0,0" Visibility="Collapsed" Click="Btn_FinishAction_Click"/>
                  </Grid>
                </Border>
              </Grid>

            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
