<Window x:Class="PatchcordInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patchcord Installer" Width="1100" Height="640"
        MinWidth="1100" MinHeight="640" MaxWidth="1100" MaxHeight="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" FontFamily="Segoe UI">

  <Window.Resources>
    <!-- Brushes -->
    <SolidColorBrush x:Key="BgSidebar" Color="#E60A0A0E"/>
    <SolidColorBrush x:Key="BgContent" Color="#F2050507"/>
    <SolidColorBrush x:Key="AccentPri" Color="#7C3AED"/>
    <SolidColorBrush x:Key="TextPri"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSec"   Color="#A1A1AA"/>

    <!-- Sidebar Nav Button -->
    <Style x:Key="NavBtn" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#71717A"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="Nav"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="14,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="32"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Indicator bar -->
                <Border x:Name="ind" Width="3" Height="20" CornerRadius="1.5" Background="#7C3AED" 
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-10,0,0,0" Opacity="0"/>
                
                <Viewbox Grid.Column="0" Width="18" Height="18" HorizontalAlignment="Left">
                  <Canvas Width="24" Height="24">
                    <Path x:Name="icon" Fill="{TemplateBinding Foreground}" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                  </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" VerticalAlignment="Center" 
                           Foreground="{TemplateBinding Foreground}" Margin="0,0,0,0"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#11FFFFFF"/>
                <Setter Property="Foreground" Value="#E4E4E7"/>
                <Setter TargetName="icon" Property="Fill" Value="#E4E4E7"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter TargetName="icon" Property="Fill" Value="#7C3AED"/>
                <Setter TargetName="ind" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Primary Button -->
    <Style x:Key="BtnPrimary" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#7C3AED" Offset="0"/>
                  <GradientStop Color="#4C1D95" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Border.Effect>
                <DropShadowEffect Color="#A855F7" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect Color="#6D28D9" BlurRadius="18" ShadowDepth="0" Opacity="0.6"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="#27272A"/>
                <Setter Property="Foreground" Value="#52525B"/>
                <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Ghost Button -->
    <Style x:Key="BtnGhost" TargetType="Button">
      <Setter Property="Foreground" Value="#E4E4E7"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#3F3F46"/>
      <Setter Property="Background" Value="#18181B"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#27272A"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#7C3AED"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- CheckBox -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E4E4E7"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="bd" Width="20" Height="20" CornerRadius="6" 
                      Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1"
                      VerticalAlignment="Center">
                <Path x:Name="check" Fill="White" Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                      Stretch="Uniform" Width="12" Height="12" Opacity="0"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#A855F7"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#7C3AED"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#7C3AED"/>
                <Setter TargetName="check" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ListBoxItem (Dashboard card) -->
    <Style x:Key="DashCardItem" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="bd" Background="#111113" CornerRadius="12"
                    BorderBrush="#27272A" BorderThickness="1" Padding="16">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#52525B"/>
                <Setter TargetName="bd" Property="Background" Value="#18181B"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    
    <!-- Titlebar Btn -->
    <Style x:Key="BtnIcon" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#3F3F46"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnClose" TargetType="Button" BasedOn="{StaticResource BtnIcon}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#EF4444"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <Border x:Name="WindowRoot" CornerRadius="16" BorderBrush="#3F3F46" BorderThickness="1" ClipToBounds="True">
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.8"/>
    </Border.Effect>
    <Grid>
      <!-- Base blurred colorful background -->
      <Border Background="#09090B"/>
      <Border Opacity="0.15">
        <Border.Background>
          <RadialGradientBrush>
            <GradientStop Color="#7C3AED" Offset="0"/>
            <GradientStop Color="#09090B" Offset="1"/>
          </RadialGradientBrush>
        </Border.Background>
      </Border>

      <!-- Layout Grid -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= UPDATE NOTIFICATION TOAST ================= -->
        <Border x:Name="UpdateToast" Grid.Column="1" Visibility="Collapsed" Panel.ZIndex="99"
                HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="16,16,16,0"
                Background="#18181B" CornerRadius="10" BorderBrush="#7C3AED" BorderThickness="1" Padding="14,10">
          <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.5"/>
          </Border.Effect>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Path Grid.Column="0" Data="M12,16L7,11H10V4H14V11H17L12,16M5,18H19V20H5V18Z" Fill="#A855F7" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="Toast_Title" Text="A new update is available" FontSize="13" FontWeight="Bold" Foreground="White"/>
              <TextBlock x:Name="Toast_Sub" Text="" FontSize="12" Foreground="#A1A1AA"/>
            </StackPanel>
            <Button Grid.Column="2" Content="Update" Style="{StaticResource BtnGhost}" Height="30" Padding="14,0" FontSize="12" Margin="0,0,8,0" Click="Toast_Update_Click"/>
            <Button Grid.Column="3" x:Name="Toast_Dismiss" Style="{StaticResource BtnIcon}" Width="28" Height="28" Click="Toast_Dismiss_Click">
              <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12Z" Fill="#A1A1AA" Width="11" Height="11" Stretch="Uniform"/>
            </Button>
          </Grid>
        </Border>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="#1E1E24" BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Window Drag Area & Logo -->
            <StackPanel Grid.Row="0" MouseDown="TitleBar_MouseDown" Background="Transparent" Margin="24,28,24,32">
              <StackPanel Orientation="Horizontal">
                <!-- Red/Yellow/Green Traffic Lights -->
                <Ellipse Width="12" Height="12" Fill="#FF5F56" Margin="0,0,6,0" Opacity="0.9" MouseLeftButtonUp="Btn_Close_Click"/>
                <Ellipse Width="12" Height="12" Fill="#FFBD2E" Margin="0,0,6,0" Opacity="0.9" MouseLeftButtonUp="Btn_Min_Click"/>
                <Ellipse Width="12" Height="12" Fill="#27C93F" Opacity="0.9"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                <Image Source="pack://application:,,,/assets/logo-x64.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Patchcord" FontSize="18" FontWeight="Black" Foreground="White" LineHeight="18"/>
                  <TextBlock Text="Installer" FontSize="12" Foreground="#71717A" Margin="0,-2,0,0"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- Navigation -->
            <StackPanel Grid.Row="1" Margin="16,0">
              <RadioButton x:Name="Nav_Dash" Content="Dashboard" IsChecked="True" Checked="Nav_Changed"
                           Style="{StaticResource NavBtn}" 
                           Tag="M13,3V11H21V3H13M3,13V21H11V13H3M3,3V11H11V3H3M13,13V21H21V13H13Z"/>
              
              <RadioButton x:Name="Nav_Proc" Content="Process Manager" Checked="Nav_Changed"
                           Style="{StaticResource NavBtn}" 
                           Tag="M16,11H8V13H16V11M20,2H4A2,2 0 0,0 2,4V20A2,2 0 0,0 4,22H20A2,2 0 0,0 22,20V4A2,2 0 0,0 20,2M20,20H4V4H20V20M12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18Z"/>
                           
              <RadioButton x:Name="Nav_Set" Content="Settings" Checked="Nav_Changed"
                           Style="{StaticResource NavBtn}" 
                           Tag="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>

              <RadioButton x:Name="Nav_Upd" Checked="Nav_Changed"
                           Style="{StaticResource NavBtn}" 
                           Tag="M12,16L7,11H10V4H14V11H17L12,16M5,18H19V20H5V18Z">
                <RadioButton.Content>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Update" VerticalAlignment="Center"/>
                    <Border x:Name="UpdDot" Width="8" Height="8" CornerRadius="4" Background="#EF4444" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                  </StackPanel>
                </RadioButton.Content>
              </RadioButton>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="24">
              <TextBlock Text="v2.0.0" FontSize="11" Foreground="#71717A" Margin="0,0,0,6"/>
              <TextBlock FontSize="11" Margin="0,0,0,2">
                <Hyperlink NavigateUri="https://patchcord.itssolar.dev/" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#A855F7">
                  <Run Text="patchcord.itssolar.dev"/>
                </Hyperlink>
              </TextBlock>
              <TextBlock FontSize="11">
                <Hyperlink NavigateUri="https://patchcord.itssolar.dev/download.html" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#A855F7">
                  <Run Text="Download Page"/>
                </Hyperlink>
              </TextBlock>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <Border Grid.Column="1" Background="{StaticResource BgContent}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="64"/> <!-- Titlebar drag space -->
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0" MouseDown="TitleBar_MouseDown" Background="Transparent"/>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0">
              <Button Style="{StaticResource BtnIcon}" Click="Btn_Min_Click">
                <Path Data="M4,11H20V13H4Z" Fill="#A1A1AA" Width="14" Height="14" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource BtnClose}" Click="Btn_Close_Click" Margin="4,0,0,0">
                <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12Z" Fill="#A1A1AA" Width="11" Height="11" Stretch="Uniform"/>
              </Button>
            </StackPanel>

            <Grid Grid.Row="1" Margin="40,10,40,40">
              <!-- ==== VIEW: DASHBOARD ==== -->
              <Grid x:Name="V_Dash" Visibility="Visible">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                  <TextBlock Text="Dashboard" FontSize="28" FontWeight="Black" Foreground="White" Margin="0,0,0,4"/>
                  <TextBlock Text="Select Discord installations to patch or repair." FontSize="14" Foreground="#A1A1AA"/>
                </StackPanel>
                
                <!-- Statistics Cards -->
                <Grid Grid.Row="1" Margin="0,0,0,24">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  
                  <Border Grid.Column="0" Background="#111113" CornerRadius="8" BorderBrush="#27272A" BorderThickness="1" Padding="12">
                    <StackPanel>
                      <TextBlock Text="Clients Detected" FontSize="11" FontWeight="Bold" Foreground="#71717A"/>
                      <TextBlock Text="{Binding ClientsCountStr}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Background="#111113" CornerRadius="8" BorderBrush="#27272A" BorderThickness="1" Padding="12">
                    <StackPanel>
                      <TextBlock Text="Total RAM Usage" FontSize="11" FontWeight="Bold" Foreground="#71717A"/>
                      <TextBlock Text="{Binding TotalRamStr}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="4" Background="#111113" CornerRadius="8" BorderBrush="#27272A" BorderThickness="1" Padding="12">
                    <StackPanel>
                      <TextBlock Text="Disk Footprint" FontSize="11" FontWeight="Bold" Foreground="#71717A"/>
                      <TextBlock Text="{Binding DiskFootprintStr}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="6" Background="#111113" CornerRadius="8" BorderBrush="#27272A" BorderThickness="1" Padding="12">
                    <StackPanel>
                      <TextBlock Text="Last Patched" FontSize="11" FontWeight="Bold" Foreground="#71717A"/>
                      <TextBlock Text="{Binding LastPatchedStr}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Border>
                </Grid>

                <!-- List of Discord Clients -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                  <ListBox x:Name="LB_Clients" Background="Transparent" BorderThickness="0"
                           ItemContainerStyle="{StaticResource DashCardItem}" SelectionMode="Multiple">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          
                          <!-- Checkbox -->
                          <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,16,0"/>
                          
                          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z" 
                                  Fill="#5865F2" Width="20" Height="20" Stretch="Uniform" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                              <TextBlock Text="{Binding ResourcesDir}" FontSize="12" Foreground="#71717A" Margin="0,2,0,0"/>
                            </StackPanel>
                          </StackPanel>
                          
                          <Border Grid.Column="2" CornerRadius="6" Padding="10,4" Background="{Binding BadgeBg}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="Bold" Foreground="{Binding BadgeFg}"/>
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </ScrollViewer>

                <!-- Action Bar -->
                <Grid Grid.Row="3" Margin="0,24,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  
                  <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh List" Style="{StaticResource BtnGhost}" Height="32" Padding="12,0" FontSize="12" Click="Btn_RefreshDash_Click"/>
                  </StackPanel>
                  
                  <Button Grid.Column="1" x:Name="Btn_UninstallSelected" Content="Uninstall Selected" Style="{StaticResource BtnGhost}" Margin="0,0,12,0" Click="Btn_UninstallSelected_Click"/>
                  <Button Grid.Column="2" x:Name="Btn_PatchSelected" Content="Patch Selected" Style="{StaticResource BtnPrimary}" Click="Btn_PatchSelected_Click"/>
                </Grid>
              </Grid>

              <!-- ==== VIEW: PROCESS MANAGER ==== -->
              <Grid x:Name="V_Proc" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                  <TextBlock Text="Process Manager" FontSize="28" FontWeight="Black" Foreground="White" Margin="0,0,0,4"/>
                  <TextBlock Text="View and terminate running Discord processes to ensure clean installation." FontSize="14" Foreground="#A1A1AA"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <ListBox x:Name="LB_Procs" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource DashCardItem}">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          
                          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z" 
                                  Fill="#5865F2" Width="20" Height="20" Stretch="Uniform" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="PID: " FontSize="12" Foreground="#71717A"/>
                                <TextBlock Text="{Binding Pid}" FontSize="12" Foreground="#A1A1AA" Margin="0,0,12,0"/>
                                <TextBlock Text="RAM: " FontSize="12" Foreground="#71717A"/>
                                <TextBlock Text="{Binding Ram}" FontSize="12" Foreground="#A1A1AA"/>
                              </StackPanel>
                            </StackPanel>
                          </StackPanel>
                          
                          <Button Grid.Column="1" Content="Kill" Style="{StaticResource BtnGhost}" Height="32" Padding="16,0" 
                                  Tag="{Binding Pid}" Click="Btn_KillProc_Click"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </ScrollViewer>

                <!-- Action Bar -->
                <Grid Grid.Row="2" Margin="0,24,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  
                  <TextBlock Grid.Column="0" x:Name="Txt_ProcCount" Text="0 Processes Running" VerticalAlignment="Center" Foreground="#71717A"/>
                  <Button Grid.Column="1" x:Name="Btn_KillAll" Content="Force Kill All Discords" Style="{StaticResource BtnPrimary}" Click="Btn_KillAll_Click">
                    <Button.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#DC2626" Offset="0"/>
                        <GradientStop Color="#9F1239" Offset="1"/>
                      </LinearGradientBrush>
                    </Button.Background>
                  </Button>
                </Grid>
              </Grid>
              
              <!-- ==== VIEW: SETTINGS ==== -->
              <Grid x:Name="V_Set" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Text="Settings" FontSize="28" FontWeight="Black" Foreground="White" Margin="0,0,0,4"/>
                  <TextBlock Text="Configure installer behavior." FontSize="14" Foreground="#A1A1AA" Margin="0,0,0,32"/>
                  
                  <!-- Setting Card -->
                  <Border Background="#111113" CornerRadius="12" BorderBrush="#27272A" BorderThickness="1" Padding="20">
                    <StackPanel>
                      <TextBlock Text="Local App.asar Source" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                      <TextBlock Text="Use a local app.asar file instead of downloading from patchcord.itssolar.dev." FontSize="13" Foreground="#A1A1AA" Margin="0,0,0,16"/>
                      
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TB_LocalAsar" Grid.Column="0" Height="38" Padding="12,0" VerticalContentAlignment="Center"
                                 Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" Foreground="White" Margin="0,0,12,0"/>
                        <Button Grid.Column="1" Content="Browse..." Style="{StaticResource BtnGhost}" Click="Btn_BrowseAsar_Click"/>
                      </Grid>
                    </StackPanel>
                  </Border>

                  <!-- Setting Card -->
                  <Border Background="#111113" CornerRadius="12" BorderBrush="#27272A" BorderThickness="1" Padding="20" Margin="0,16,0,0">
                    <StackPanel>
                      <TextBlock Text="Auto-Close" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                      <CheckBox x:Name="CB_AutoClose" Content="Close installer automatically after successful patch" IsChecked="False" Margin="0,8,0,0"/>
                    </StackPanel>
                  </Border>

                </StackPanel>
              </Grid>

              <!-- ==== VIEW: UPDATE ==== -->
              <Grid x:Name="V_Upd" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                  <TextBlock Text="Update" FontSize="28" FontWeight="Black" Foreground="White" Margin="0,0,0,4"/>
                  <TextBlock Text="Check for and install the latest version of Patchcord Installer." FontSize="14" Foreground="#A1A1AA"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                  <!-- Current / Latest version card -->
                  <Border Background="#111113" CornerRadius="12" BorderBrush="#27272A" BorderThickness="1" Padding="20">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="Installed Version" FontSize="12" FontWeight="Bold" Foreground="#71717A"/>
                        <TextBlock x:Name="Upd_CurrentVer" Text="—" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Latest Version" FontSize="12" FontWeight="Bold" Foreground="#71717A"/>
                        <TextBlock x:Name="Upd_LatestVer" Text="Checking…" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>

                  <!-- Status / Notes card -->
                  <Border Background="#111113" CornerRadius="12" BorderBrush="#27272A" BorderThickness="1" Padding="20" Margin="0,16,0,0">
                    <StackPanel>
                      <TextBlock x:Name="Upd_StatusText" Text="Checking for updates…" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                      <TextBlock x:Name="Upd_NotesText" Text="" FontSize="13" Foreground="#A1A1AA" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>

                  <!-- Force update warning -->
                  <Border x:Name="Upd_ForceBanner" Background="#2D0C0C" CornerRadius="12" BorderBrush="#EF4444" BorderThickness="1" Padding="16" Margin="0,16,0,0" Visibility="Collapsed">
                    <TextBlock Text="This version is no longer supported. You must update before continuing." FontSize="13" FontWeight="Bold" Foreground="#FCA5A5" TextWrapping="Wrap"/>
                  </Border>

                  <!-- Progress -->
                  <ProgressBar x:Name="Upd_Progress" Height="8" Margin="0,16,0,0" Visibility="Collapsed"
                               Background="#18181B" BorderThickness="0" Foreground="{StaticResource AccentPri}"/>

                  <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1" x:Name="Btn_CheckUpdate" Content="Check Again" Style="{StaticResource BtnGhost}" Margin="0,0,12,0" Click="Btn_CheckUpdate_Click"/>
                    <Button Grid.Column="2" x:Name="Btn_InstallUpdate" Content="Update Now" Style="{StaticResource BtnPrimary}" IsEnabled="False" Click="Btn_InstallUpdate_Click"/>
                  </Grid>
                </StackPanel>
              </Grid>

              <!-- ==== VIEW: ACTION (Overlay) ==== -->
              <Grid x:Name="V_Action" Visibility="Collapsed" Background="#D9000000">
                <Border Background="#111113" CornerRadius="16" BorderBrush="#27272A" BorderThickness="1" Width="500" Height="400" Padding="32">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="Act_Title" Text="Patching Clients..." FontSize="22" FontWeight="Black" Foreground="White" Margin="0,0,0,16" HorizontalAlignment="Center"/>
                    
                    <ScrollViewer Grid.Row="1" x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Background="#09090B" Padding="12">
                      <ItemsControl x:Name="LogItems">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                              <Run Text="{Binding Prefix}" Foreground="{Binding Color}" FontWeight="Bold"/>
                              <Run Text=" "/>
                              <Run Text="{Binding Message}" Foreground="#A1A1AA"/>
                            </TextBlock>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="2" x:Name="Btn_FinishAction" Content="Close" Style="{StaticResource BtnGhost}" Margin="0,16,0,0" Visibility="Collapsed" Click="Btn_FinishAction_Click"/>
                  </Grid>
                </Border>
              </Grid>

            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>