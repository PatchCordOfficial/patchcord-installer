<Window x:Class="PatchcordInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patchcord Installer" Width="1080" Height="680"
        MinWidth="790" MinHeight="570" WindowStartupLocation="CenterScreen"
        Background="#101010" Icon="assets/logo-x32.png"
        UseLayoutRounding="True" Loaded="Window_Loaded" FontFamily="Segoe UI">

  <Window.Resources>
    <SolidColorBrush x:Key="BgCard" Color="#1D1D1D"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#393939"/>
    <SolidColorBrush x:Key="TextPri" Color="White"/>
    <SolidColorBrush x:Key="TextSec" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="TextMute" Color="#AAAAAAAA"/>
    <SolidColorBrush x:Key="AccentA" Color="White"/>

    <Style x:Key="BtnGhost" TargetType="Button">
      <Setter Property="Background" Value="#252525"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#535353"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" CornerRadius="5" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="Opacity" Value="0.78"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="#888888"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#111111"/>
      <Setter Property="BorderBrush" Value="White"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Background" Value="#262626"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#393939"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>


    <Style x:Key="NavBtn" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#B7B7B7"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="Navigation"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Tab" Background="Transparent" BorderThickness="0,0,0,2"
                    BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Tab" Property="Background" Value="#262626"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Tab" Property="BorderBrush" Value="White"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Search box ===================== -->
    <Style x:Key="SearchBox" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource BgCard}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPri}"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentA}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Background="#191919" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1"
            Padding="24,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,30,0">
          <Image Source="assets/logo-x64.png" Width="24" Height="24" Margin="0,0,9,0"/>
          <TextBlock Text="Patchcord" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="Nav_Dash" Content="Installations" IsChecked="True" Checked="Nav_Changed" Style="{StaticResource NavBtn}"/>
          <RadioButton x:Name="Nav_Proc" Content="Processes" Checked="Nav_Changed" Style="{StaticResource NavBtn}"/>
          <RadioButton x:Name="Nav_Set" Content="Settings" Checked="Nav_Changed" Style="{StaticResource NavBtn}"/>
          <RadioButton x:Name="Nav_Upd" Checked="Nav_Changed" Style="{StaticResource NavBtn}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Updates"/>
              <Ellipse x:Name="UpdDot" Fill="White" Width="6" Height="6" Margin="7,0,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border x:Name="UpdateToast" Grid.Row="1" Background="#222222" Visibility="Collapsed" Padding="24,8">
      <DockPanel LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="Dismiss" Style="{StaticResource BtnGhost}" Click="Toast_Dismiss_Click"/>
        <Button DockPanel.Dock="Right" Content="View update" Style="{StaticResource BtnPrimary}" Click="Toast_Update_Click" Margin="0,0,8,0"/>
        <TextBlock x:Name="Toast_Sub" VerticalAlignment="Center" Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="28,26">
      <Grid x:Name="V_Dash">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,22">
          <Button DockPanel.Dock="Right" Content="Rescan" Style="{StaticResource BtnGhost}" Click="Btn_RefreshDash_Click"
                  VerticalAlignment="Center"/>
          <StackPanel>
            <TextBlock Text="Discord installations" Foreground="White" FontSize="34" FontWeight="SemiBold"/>
            <TextBlock Text="Select the clients you want to patch or restore." Foreground="{StaticResource TextSec}" Margin="0,5,0,0"/>
          </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
          <Grid DockPanel.Dock="Right" Width="215">
            <TextBox x:Name="TB_Search" Style="{StaticResource SearchBox}" AutomationProperties.Name="Filter installations"
                     TextChanged="TB_Search_TextChanged"/>
            <TextBlock x:Name="TB_SearchPlaceholder" Text="Filter installations" Margin="12,0,0,0"
                       Foreground="{StaticResource TextSec}" IsHitTestVisible="False" VerticalAlignment="Center"/>
          </Grid>
          <TextBlock Text="{Binding ClientsCountStr, StringFormat={}{0} detected}" VerticalAlignment="Center"
                     Foreground="{StaticResource TextSec}"/>
        </DockPanel>

        <Grid Grid.Row="2">
          <DataGrid x:Name="LB_Clients" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                    CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                    HorizontalGridLinesBrush="#333333" Background="#151515" Foreground="White"
                    BorderBrush="#383838" BorderThickness="1" RowBackground="#181818" AlternatingRowBackground="#202020"
                    MinRowHeight="44" ColumnHeaderHeight="36" SelectionMode="Single"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <DataGrid.ColumnHeaderStyle>
              <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#262626"/>
                <Setter Property="Foreground" Value="#E0E0E0"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Resources>
              <Style TargetType="DataGridCell">
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                      <Border x:Name="Cell" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                              Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                          <Setter TargetName="Cell" Property="BorderBrush" Value="#8C8C8C"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
              <DataGridTemplateColumn Width="48" CanUserSort="False" IsReadOnly="True">
                <DataGridTemplateColumn.Header>
                  <CheckBox x:Name="CB_SelectAll" Click="CB_SelectAll_Click" AutomationProperties.Name="Select all installations"/>
                </DataGridTemplateColumn.Header>
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Label}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Client" Binding="{Binding Label}" Width="165" IsReadOnly="True"/>
              <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="105" IsReadOnly="True"/>
              <DataGridTextColumn Header="Status" Binding="{Binding StatusLabel}" Width="110" IsReadOnly="True"/>
              <DataGridTextColumn Header="Resources folder" Binding="{Binding ResourcesDir}" Width="*" IsReadOnly="True">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    <Setter Property="FontFamily" Value="Consolas"/>
                    <Setter Property="ToolTip" Value="{Binding ResourcesDir}"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock x:Name="Txt_EmptyState" Text="No Discord installations with a resources/app.asar file were found."
                     Foreground="{StaticResource TextSec}" HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,16,0,0" LastChildFill="False">
          <Button DockPanel.Dock="Right" Content="Patch selected" Style="{StaticResource BtnPrimary}" Click="Btn_PatchSelected_Click"/>
          <Button DockPanel.Dock="Right" Content="Restore selected" Style="{StaticResource BtnGhost}" Click="Btn_UninstallSelected_Click" Margin="0,0,8,0"/>
          <TextBlock DockPanel.Dock="Left" Foreground="{StaticResource TextSec}" VerticalAlignment="Center">
            <Run Text="Patch size "/><Run Text="{Binding DiskFootprintStr, Mode=OneWay}"/>
            <Run Text="   ·   Last patched "/><Run Text="{Binding LastPatchedStr, Mode=OneWay}"/>
          </TextBlock>
        </DockPanel>
      </Grid>

      <Grid x:Name="V_Proc" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,22">
          <Button DockPanel.Dock="Right" Content="End all Discord processes" Style="{StaticResource BtnGhost}"
                  Click="Btn_KillAll_Click" VerticalAlignment="Center"/>
          <StackPanel>
            <TextBlock Text="Discord processes" Foreground="White" FontSize="34" FontWeight="SemiBold"/>
            <TextBlock x:Name="Txt_ProcCount" Text="0 processes running" Foreground="{StaticResource TextSec}" Margin="0,5,0,0"/>
          </StackPanel>
        </DockPanel>
        <ListView x:Name="LB_Procs" Grid.Row="1" Background="#181818" Foreground="White" BorderBrush="#383838">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Process" Width="230" DisplayMemberBinding="{Binding Name}"/>
              <GridViewColumn Header="PID" Width="110" DisplayMemberBinding="{Binding Pid}"/>
              <GridViewColumn Header="Memory" Width="125" DisplayMemberBinding="{Binding Ram}"/>
              <GridViewColumn Header="Action" Width="150">
                <GridViewColumn.CellTemplate>
                  <DataTemplate>
                    <Button Content="End process" Height="30" Style="{StaticResource BtnGhost}"
                            Tag="{Binding Pid}" Click="Btn_KillProc_Click" Margin="0,4"/>
                  </DataTemplate>
                </GridViewColumn.CellTemplate>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>
      </Grid>
      <!-- ==== VIEW: SETTINGS ==== -->
      <Grid x:Name="V_Set" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Settings" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource TextPri}" Margin="0,0,0,4"/>
          <TextBlock Text="Choose a patch source and what happens after patching." FontSize="14" Foreground="{StaticResource TextSec}" Margin="0,0,0,28"/>

          <!-- Setting Card -->
          <Border Background="{StaticResource BgCard}" CornerRadius="5" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="20">
            <StackPanel>
              <TextBlock Text="Local App.asar Source" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPri}" Margin="0,0,0,6"/>
              <TextBlock Text="Use a local app.asar file instead of downloading from patchcord.itssolar.dev." FontSize="13" Foreground="{StaticResource TextSec}" Margin="0,0,0,16"/>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TB_LocalAsar" Grid.Column="0" Height="40" Padding="12,0" VerticalContentAlignment="Center"
                         Background="#242424" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Foreground="{StaticResource TextPri}" Margin="0,0,12,0"/>
                <Button Grid.Column="1" Content="Browse..." Style="{StaticResource BtnGhost}" Click="Btn_BrowseAsar_Click"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Setting Card -->
          <Border Background="{StaticResource BgCard}" CornerRadius="5" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="20" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="Auto-Close" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPri}" Margin="0,0,0,6"/>
              <CheckBox x:Name="CB_AutoClose" Content="Close installer automatically after successful patch" IsChecked="False" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- ==== VIEW: UPDATE ==== -->
      <Grid x:Name="V_Upd" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
          <TextBlock Text="Update" FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource TextPri}" Margin="0,0,0,4"/>
          <TextBlock Text="Check for and install the latest version of Patchcord Installer." FontSize="14" Foreground="{StaticResource TextSec}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
          <!-- Current / Latest version card -->
          <Border Background="{StaticResource BgCard}" CornerRadius="5" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="20">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Installed Version" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMute}"/>
                <TextBlock x:Name="Upd_CurrentVer" Text="—" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPri}" Margin="0,4,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Latest Version" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMute}"/>
                <TextBlock x:Name="Upd_LatestVer" Text="Checking…" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPri}" Margin="0,4,0,0"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Status / Notes card -->
          <Border Background="{StaticResource BgCard}" CornerRadius="5" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="20" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock x:Name="Upd_StatusText" Text="Checking for updates…" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPri}" Margin="0,0,0,6"/>
              <TextBlock x:Name="Upd_NotesText" Text="" FontSize="13" Foreground="{StaticResource TextSec}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- Force update warning -->
          <Border x:Name="Upd_ForceBanner" Background="#282828" CornerRadius="5" BorderBrush="#777777" BorderThickness="1" Padding="16" Margin="0,16,0,0" Visibility="Collapsed">
            <TextBlock Text="This version is no longer supported. You must update before continuing." FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
          </Border>

          <!-- Progress -->
          <ProgressBar x:Name="Upd_Progress" Height="8" Margin="0,16,0,0" Visibility="Collapsed"
                       Background="#242424" BorderThickness="0" Foreground="{StaticResource AccentA}"/>

          <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" x:Name="Btn_CheckUpdate" Content="Check Again" Style="{StaticResource BtnGhost}" Margin="0,0,12,0" Click="Btn_CheckUpdate_Click"/>
            <Button Grid.Column="2" x:Name="Btn_InstallUpdate" Content="Update Now" Style="{StaticResource BtnPrimary}" IsEnabled="False" Click="Btn_InstallUpdate_Click"/>
          </Grid>
        </StackPanel></ScrollViewer>
      </Grid>

    </Grid>
    <Border Grid.Row="3" Background="#191919" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="24,9">
      <DockPanel>
        <TextBlock x:Name="Txt_FooterVersion" DockPanel.Dock="Right" Foreground="{StaticResource TextSec}"/>
        <TextBlock>
          <Hyperlink NavigateUri="https://patchcord.itssolar.dev/" Foreground="{StaticResource TextSec}" RequestNavigate="Hyperlink_RequestNavigate">Patchcord website</Hyperlink>
          <Run Text="   ·   "/>
          <Hyperlink NavigateUri="https://patchcord.itssolar.dev/download.html" Foreground="{StaticResource TextSec}" RequestNavigate="Hyperlink_RequestNavigate">Downloads</Hyperlink>
        </TextBlock>
      </DockPanel>
    </Border>
    <!-- ==== VIEW: ACTION (Overlay) ==== -->
    <Grid x:Name="V_Action" Grid.RowSpan="4" Visibility="Collapsed" Background="#D9000000">
      <Border Background="{StaticResource BgCard}" CornerRadius="6" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Width="520" Height="380" Padding="32">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" x:Name="Act_Title" Text="Patching Clients..." FontSize="22" FontWeight="Black" Foreground="{StaticResource TextPri}" Margin="0,0,0,16" HorizontalAlignment="Left"/>

          <ScrollViewer Grid.Row="1" x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Background="#101010" Padding="14">
            <ItemsControl x:Name="LogItems">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                    <Run Text="{Binding Prefix}" Foreground="White" FontWeight="Bold"/>
                    <Run Text=" "/>
                    <Run Text="{Binding Message}" Foreground="{StaticResource TextSec}"/>
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <Button Grid.Row="2" x:Name="Btn_FinishAction" Content="Close" Style="{StaticResource BtnGhost}" Margin="0,16,0,0" Visibility="Collapsed" Click="Btn_FinishAction_Click"/>
        </Grid>
      </Border>
    </Grid>

  </Grid>
</Window>
