<Window x:Class="PatchcordInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Patchcord Installer" Width="1220" Height="720"
        MinWidth="1000" MinHeight="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        Icon="https://patchcord.itssolar.dev/logo.png"
        StateChanged="Window_StateChanged"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled" RenderOptions.EdgeMode="Aliased"
        Loaded="Window_Loaded" FontFamily="Segoe UI">

  <Window.Resources>

    <!-- ===================== Palette ===================== -->
    <SolidColorBrush x:Key="BgBase"     Color="#0B0B10"/>
    <SolidColorBrush x:Key="BgSidebar"  Color="#EE111116"/>
    <SolidColorBrush x:Key="BgContent"  Color="#F5070709"/>
    <SolidColorBrush x:Key="BgCard"     Color="#14141B"/>
    <SolidColorBrush x:Key="BgCardHov"  Color="#1B1B24"/>
    <SolidColorBrush x:Key="BorderSubtle" Color="#22222C"/>
    <SolidColorBrush x:Key="BorderHover"  Color="#3A3A4A"/>
    <SolidColorBrush x:Key="TextPri"    Color="#F5F5F7"/>
    <SolidColorBrush x:Key="TextSec"    Color="#9494A3"/>
    <SolidColorBrush x:Key="TextMute"   Color="#5C5C6B"/>
    <SolidColorBrush x:Key="AccentA"    Color="#8B5CF6"/>
    <SolidColorBrush x:Key="AccentB"    Color="#22D3EE"/>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#8B5CF6" Offset="0"/>
      <GradientStop Color="#4F46E5" Offset="0.55"/>
      <GradientStop Color="#22D3EE" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#F43F5E" Offset="0"/>
      <GradientStop Color="#9F1239" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===================== Sidebar Nav Button ===================== -->
    <Style x:Key="NavBtn" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#7A7A8C"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="GroupName" Value="Nav"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="12,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="34"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="iconChip" Grid.Column="0" Width="28" Height="28" CornerRadius="8"
                        Background="#1D1D26" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <Viewbox Width="15" Height="15">
                    <Canvas Width="24" Height="24">
                      <Path x:Name="icon" Fill="{TemplateBinding Foreground}" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Canvas>
                  </Viewbox>
                </Border>

                <ContentPresenter x:Name="content" Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0"
                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#14141C"/>
                <Setter Property="Foreground" Value="#D4D4DC"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentGradient}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter TargetName="iconChip" Property="Background" Value="#22FFFFFF"/>
                <Setter TargetName="bd" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect Color="#8B5CF6" BlurRadius="20" ShadowDepth="0" Opacity="0.45"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===================== Primary Button ===================== -->
    <Style x:Key="BtnPrimary" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="22,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="{StaticResource AccentGradient}">
              <Border.Effect>
                <DropShadowEffect Color="#8B5CF6" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="RenderTransform">
                  <Setter.Value>
                    <ScaleTransform ScaleX="1.015" ScaleY="1.06"/>
                  </Setter.Value>
                </Setter>
                <Setter TargetName="bd" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                <Setter TargetName="bd" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect Color="#8B5CF6" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="#1D1D26"/>
                <Setter Property="Foreground" Value="#4A4A56"/>
                <Setter TargetName="bd" Property="Effect" Value="{x:Null}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===================== Danger Button ===================== -->
    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="{StaticResource DangerGradient}">
              <Border.Effect>
                <DropShadowEffect Color="#F43F5E" BlurRadius="16" ShadowDepth="0" Opacity="0.35"/>
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect Color="#F43F5E" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===================== Ghost Button ===================== -->
    <Style x:Key="BtnGhost" TargetType="Button">
      <Setter Property="Foreground" Value="#D4D4DC"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
      <Setter Property="Background" Value="#14141B"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1B1B24"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentA}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===================== CheckBox ===================== -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#D4D4DC"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="bd" Width="20" Height="20" CornerRadius="6"
                      Background="#18181F" BorderBrush="{StaticResource BorderHover}" BorderThickness="1"
                      VerticalAlignment="Center">
                <Path x:Name="check" Fill="White" Data="M9,16.17L4.83,12L3.41,13.41L9,19L21,7L19.59,5.59L9,16.17Z"
                      Stretch="Uniform" Width="12" Height="12" Opacity="0"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentA}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentGradient}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{x:Null}"/>
                <Setter TargetName="check" Property="Opacity" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===================== ListBoxItem (Dashboard/Process card) ===================== -->
    <Style x:Key="DashCardItem" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="bd" Background="{StaticResource BgCard}" CornerRadius="14"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="18,16">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BorderHover}"/>
                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgCardHov}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===================== Stat Chip Card ===================== -->
    <Style x:Key="StatCard" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource BgCard}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- ===================== Titlebar circular icon buttons ===================== -->
    <Style x:Key="BtnIcon" TargetType="Button">
      <Setter Property="Background" Value="#14141B"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#24242F"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BtnClose" TargetType="Button" BasedOn="{StaticResource BtnIcon}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#F43F5E"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===================== Search box ===================== -->
    <Style x:Key="SearchBox" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource BgCard}"/>
      <Setter Property="Foreground" Value="{StaticResource TextPri}"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="34,0,12,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentA}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <Border x:Name="WindowRoot" Margin="12" CornerRadius="20" BorderBrush="#2A2A38" BorderThickness="1" ClipToBounds="True">
    <Border.Effect>
      <DropShadowEffect x:Name="WindowShadow" Color="#000000" BlurRadius="48" ShadowDepth="14" Opacity="0.75" RenderingBias="Quality"/>
    </Border.Effect>
    <Grid>
      <!-- Base aurora background -->
      <Border Background="{StaticResource BgBase}"/>
      <Border Opacity="0.22" IsHitTestVisible="False">
        <Border.Background>
          <RadialGradientBrush Center="0.05,0" RadiusX="0.7" RadiusY="0.9">
            <GradientStop Color="#8B5CF6" Offset="0"/>
            <GradientStop Color="#0B0B10" Offset="1"/>
          </RadialGradientBrush>
        </Border.Background>
      </Border>
      <Border Opacity="0.16" IsHitTestVisible="False">
        <Border.Background>
          <RadialGradientBrush Center="1,1" RadiusX="0.6" RadiusY="0.8">
            <GradientStop Color="#22D3EE" Offset="0"/>
            <GradientStop Color="#0B0B10" Offset="1"/>
          </RadialGradientBrush>
        </Border.Background>
      </Border>

      <!-- Layout Grid -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="232"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= UPDATE NOTIFICATION TOAST ================= -->
        <Border x:Name="UpdateToast" Grid.Column="1" Visibility="Collapsed" Panel.ZIndex="99"
                HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="20,20,20,0"
                Background="#16161F" CornerRadius="12" BorderBrush="{StaticResource AccentA}" BorderThickness="1" Padding="16,12">
          <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="6" Opacity="0.5"/>
          </Border.Effect>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="9" Background="{StaticResource AccentGradient}" Margin="0,0,12,0">
              <Path Data="M12,16L7,11H10V4H14V11H17L12,16M5,18H19V20H5V18Z" Fill="White" Width="14" Height="14" Stretch="Uniform"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="Toast_Title" Text="A new update is available" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPri}"/>
              <TextBlock x:Name="Toast_Sub" Text="" FontSize="12" Foreground="{StaticResource TextSec}"/>
            </StackPanel>
            <Button Grid.Column="2" Content="Update" Style="{StaticResource BtnGhost}" Height="32" Padding="14,0" FontSize="12" Margin="0,0,8,0" Click="Toast_Update_Click"/>
            <Button Grid.Column="3" x:Name="Toast_Dismiss" Style="{StaticResource BtnIcon}" Width="28" Height="28" Click="Toast_Dismiss_Click">
              <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12Z" Fill="{StaticResource TextSec}" Width="11" Height="11" Stretch="Uniform"/>
            </Button>
          </Grid>
        </Border>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="#1C1C24" BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Window Drag Area & Logo -->
            <StackPanel Grid.Row="0" MouseDown="TitleBar_MouseDown" Background="Transparent" Margin="24,26,24,30">
              <StackPanel Orientation="Horizontal">
                <!-- Red/Yellow/Green Traffic Lights -->
                <Ellipse Width="13" Height="13" Fill="#FF5F56" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="Btn_Close_Click" ToolTip="Close"/>
                <Ellipse Width="13" Height="13" Fill="#FFBD2E" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="Btn_Min_Click" ToolTip="Minimize"/>
                <Ellipse Width="13" Height="13" Fill="#27C93F" Cursor="Hand" MouseLeftButtonUp="Btn_Max_Click" ToolTip="Maximize / Restore"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                <Border Width="36" Height="36" CornerRadius="10" Background="#1A1A22">
                  <Image Source="https://patchcord.itssolar.dev/logo.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"
                         RenderOptions.EdgeMode="Aliased"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Patchcord" FontSize="18" FontWeight="Black" Foreground="{StaticResource TextPri}" LineHeight="18"/>
                  <TextBlock Text="Installer" FontSize="12" Foreground="{StaticResource TextMute}" Margin="0,-2,0,0"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- Navigation -->
            <StackPanel Grid.Row="1" Margin="16,4">
              <TextBlock Text="MENU" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMute}" Margin="14,0,0,10"/>

              <RadioButton x:Name="Nav_Dash" Content="Dashboard" IsChecked="True" Checked="Nav_Changed"
                           Style="{StaticResource NavBtn}"
                           Tag="M13,3V11H21V3H13M3,13V21H11V13H3M3,3V11H11V3H3M13,13V21H21V13H13Z"/>

              <RadioButton x:Name="Nav_Proc" Content="Process Manager" Checked="Nav_Changed"
                           Style="{StaticResource NavBtn}"
                           Tag="M16,11H8V13H16V11M20,2H4A2,2 0 0,0 2,4V20A2,2 0 0,0 4,22H20A2,2 0 0,0 22,20V4A2,2 0 0,0 20,2M20,20H4V4H20V20M12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18Z"/>

              <RadioButton x:Name="Nav_Set" Content="Settings" Checked="Nav_Changed"
                           Style="{StaticResource NavBtn}"
                           Tag="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>

              <TextBlock Text="MAINTENANCE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMute}" Margin="14,18,0,10"/>

              <RadioButton x:Name="Nav_Upd" Checked="Nav_Changed"
                           Style="{StaticResource NavBtn}"
                           Tag="M12,16L7,11H10V4H14V11H17L12,16M5,18H19V20H5V18Z">
                <RadioButton.Content>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Update" VerticalAlignment="Center"/>
                    <Border x:Name="UpdDot" Width="8" Height="8" CornerRadius="4" Background="#F43F5E" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                  </StackPanel>
                </RadioButton.Content>
              </RadioButton>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="24,20">
              <Border Background="#16161F" CornerRadius="10" Padding="12" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                <StackPanel>
                  <TextBlock x:Name="Txt_FooterVersion" Text="v2.2.1" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSec}" Margin="0,0,0,6"/>
                  <TextBlock FontSize="11" Margin="0,0,0,2">
                    <Hyperlink NavigateUri="https://patchcord.itssolar.dev/" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{StaticResource AccentB}">
                      <Run Text="patchcord.itssolar.dev"/>
                    </Hyperlink>
                  </TextBlock>
                  <TextBlock FontSize="11">
                    <Hyperlink NavigateUri="https://patchcord.itssolar.dev/download.html" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{StaticResource AccentB}">
                      <Run Text="Download Page"/>
                    </Hyperlink>
                  </TextBlock>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <Border Grid.Column="1" Background="{StaticResource BgContent}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="60"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" MouseDown="TitleBar_MouseDown" Background="Transparent"/>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,16,0">
              <Button Style="{StaticResource BtnIcon}" Click="Btn_Min_Click" ToolTip="Minimize">
                <Path Data="M4,11H20V13H4Z" Fill="{StaticResource TextSec}" Width="14" Height="14" Stretch="Uniform"/>
              </Button>
              <Button x:Name="Btn_Max" Style="{StaticResource BtnIcon}" Click="Btn_Max_Click" Margin="6,0,0,0" ToolTip="Maximize / Restore">
                <Path x:Name="MaxIcon" Data="M4,4H20V20H4V4M6,8V18H18V8H6Z" Fill="{StaticResource TextSec}" Width="13" Height="13" Stretch="Uniform"/>
              </Button>
              <Button Style="{StaticResource BtnClose}" Click="Btn_Close_Click" Margin="6,0,0,0" ToolTip="Close">
                <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12Z" Fill="{StaticResource TextSec}" Width="11" Height="11" Stretch="Uniform"/>
              </Button>
            </StackPanel>

            <Grid Grid.Row="1" Margin="44,8,44,36">
              <!-- ==== VIEW: DASHBOARD ==== -->
              <Grid x:Name="V_Dash" Visibility="Visible">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,22">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="240"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Dashboard" FontSize="30" FontWeight="Black" Foreground="{StaticResource TextPri}" Margin="0,0,0,4"/>
                    <TextBlock Text="Select Discord installations to patch or repair." FontSize="14" Foreground="{StaticResource TextSec}"/>
                  </StackPanel>
                  <Grid Grid.Column="1" VerticalAlignment="Bottom">
                    <TextBox x:Name="TB_Search" Style="{StaticResource SearchBox}" TextChanged="TB_Search_TextChanged"/>
                    <TextBlock x:Name="TB_SearchPlaceholder" Text="Search clients…" Foreground="{StaticResource TextMute}" FontSize="13" Margin="34,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                          Fill="{StaticResource TextMute}" Width="14" Height="14" Stretch="Uniform" Margin="12,0,0,0"
                          HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                  </Grid>
                </Grid>

                <!-- Statistics Cards -->
                <Grid Grid.Row="1" Margin="0,0,0,22">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <Border Grid.Column="0" Style="{StaticResource StatCard}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Border Width="34" Height="34" CornerRadius="9" Background="#2A1E4D" VerticalAlignment="Top">
